# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
# Grafo de conocimiento generado por graphify: salida derivada del
# propio codigo, se regenera con /graphify. Ademas .graphify_root y
# .graphify_python guardan rutas absolutas de la maquina que lo genero,
# asi que no le sirven a nadie mas.
/graphify-out
/node_modules
/platforms
/plugins
/www
